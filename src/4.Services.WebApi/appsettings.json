{
  "DatabaseProvider": "PostgreSQL",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=join_db;Username=postgres;Password=postgres;Timeout=60;"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "UNA_CLAVE_SUPER_SECRETA_DE_AL_MENOS_32_CARACTERES_12345",
    "Issuer": "JOIN.Services.WebApi",
    "Audience": "JOIN.Client",
    "ExpirationMinutes": 129600,
    "RefreshTokenExpirationDays": 30
  },
  "PasswordPolicy": {
    "MinimumLength": 8,
    "RestrictRepetitiveChars": true,
    "RestrictCommonSequences": true,
    "RestrictUsernameInPassword": true
  },
  "Pagination": {
    "DefaultPageNumber": 1,
    "DefaultPageSize": 20,
    "MaxPageSize": 100,
    "MinPageSize": 1
  },
  "Performance": {
    "ThresholdMilliseconds": 200
  },
  "AppUrls": {
    "FrontendBaseUrl": "https://localhost:4200"
  },
  "SendGrid": {
    "ApiKey": "YOUR_SENDGRID_API_KEY_HERE",
    "FromEmail": "from@email.com",
    "FromName": "JOIN CRM Notifications"
  },
  "Mfa": {
    "ChallengeExpirationMinutes": 5
  },
  "HealthCheckAlerts": {
    "AdminEmails": [
      "to@email.com"
    ],
    "SubjectPrefix": "[JOIN CRM] ALERTA DE SISTEMA"
  },
  "FileStorage": {
    "Provider": "Local",
    "Local": {
      "RootPath": "App_Data/ticket-attachments"
    }
  },
  "HealthChecksUI": {
    "HealthChecks": [
      {
        "Name": "JOIN CRM - Database",
        "Uri": "/health/ready"
      }
    ],
    "EvaluationTimeInSeconds": 30,
    "MinimumSecondsBetweenFailureNotifications": 60
  },
  "RateLimiting": {
    "EnableStrictSecurity": false,
    "Global": {
      "PermitLimit": 100,
      "WindowSeconds": 60,
      "QueueLimit": 0,
      "QueueProcessingOrder": "OldestFirst"
    },
    "Strict": {
      "PermitLimit": 5,
      "WindowSeconds": 60,
      "QueueLimit": 0,
      "QueueProcessingOrder": "OldestFirst"
    },
    "Rejection": {
      "Type": "https://httpstatuses.com/429",
      "Title": "Too Many Requests",
      "Detail": "Rate limit exceeded. Please try again later."
    }
  }
}