<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Controllers/**/*.cs" />
    <Compile Include="Filters/**/*.cs" />
    <Compile Include="Middlewares/**/*.cs" />
    <Compile Include="Services/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="appsettings.json" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="appsettings.*.json" CopyToPublishDirectory="PreserveNewest" DependentUpon="appsettings.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Http" Version="10.0.0" />
    <PackageReference Include="Asp.Versioning.Mvc" Version="10.0.0" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.0.0" />
    <PackageReference Include="AspNetCore.HealthChecks.UI" Version="9.0.0" />
    <PackageReference Include="AspNetCore.HealthChecks.UI.Client" Version="9.0.0" />
    <PackageReference Include="AspNetCore.HealthChecks.UI.InMemory.Storage" Version="9.0.0" />
    <!-- Direct override to pull the patched KubernetesClient over the vulnerable 15.0.1 that AspNetCore.HealthChecks.UI 9.0.0 brings transitively (NU1902). -->
    <PackageReference Include="KubernetesClient" Version="18.0.13" />
    <!-- Restores IdentityModel.dll transitively. HealthChecks.UI.Core binds against the IdentityModel surface that KubernetesClient 15.0.1 used to bring; the override above drops it. -->
    <PackageReference Include="IdentityModel.OidcClient" Version="5.2.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.2" />
    <!-- Direct override to pull the patched Microsoft.OpenApi over the vulnerable 2.0.0 that Microsoft.AspNetCore.OpenApi 10.0.2 brings transitively (NU1903). -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.10.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" Version="2.12.54" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../2.Application/JOIN.Application.csproj" />
    <ProjectReference Include="../3.Infrastructure/JOIN.Infrastructure.csproj" />
    <ProjectReference Include="../3.Persistence/JOIN.Persistence.csproj" />
  </ItemGroup>
</Project>